<style>
  :root{
    --bg:#F7F7FB;--surface:#FFFFFF;--ink:#15133D;--muted:#4E4C74;--line:#DFDEEC;--line-strong:#B9B7D3;
    --accent-ink:#2F2A93;--green:#00D47E;--band:#1C1863;--on-green:#0B0A2A;
    --serif:'Newsreader',Georgia,serif;--sans:'IBM Plex Sans',system-ui,sans-serif;--mono:'IBM Plex Mono',ui-monospace,monospace;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0D0B24;--surface:#16143A;--ink:#EEEDFB;--muted:#ADAAD3;--line:#2A2756;--line-strong:#4A4682;
      --accent-ink:#2EF2A0;--green:#2EF2A0;--band:#1A1748;
    }
  }
  :root[data-theme="dark"]{
    --bg:#0D0B24;--surface:#16143A;--ink:#EEEDFB;--muted:#ADAAD3;--line:#2A2756;--line-strong:#4A4682;
    --accent-ink:#2EF2A0;--green:#2EF2A0;--band:#1A1748;
  }
  *,*::before,*::after{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--accent-ink);outline-offset:3px}
  .wrap{max-width:1200px;margin:0 auto;padding-left:clamp(20px,5vw,64px);padding-right:clamp(20px,5vw,64px)}
  .section{padding-top:clamp(56px,8vw,104px);padding-bottom:clamp(56px,8vw,104px)}
  .rule{border-top:1px solid var(--line)}
  .eyebrow{margin:0 0 14px;font-family:var(--mono);font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-ink)}
  h1,h2,h3{font-family:var(--serif);font-weight:500;margin:0}
  h2{font-size:clamp(34px,4vw,52px);line-height:1.1;letter-spacing:-.01em;max-width:820px}
  .muted{color:var(--muted)}
  .row{display:flex;flex-wrap:wrap}

  /* Masthead */
  .top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding-top:18px;padding-bottom:18px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
  .wordmark{font-family:var(--serif);font-size:26px;font-weight:600;letter-spacing:.02em}
  .wordmark span{color:var(--accent-ink)}
  .actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;font:600 15px var(--sans);text-decoration:none;cursor:pointer;border:0}
  .btn-green{background:var(--green);color:var(--on-green)}
  .btn-green:hover{filter:brightness(1.06)}
  .btn-ghost{background:transparent;color:var(--ink);border:1px solid var(--line);font-weight:500;font-size:14px}
  .btn-ghost:hover{border-color:var(--line-strong)}
  .sections{border-top:1px solid var(--line)}
  .sections .wrap{display:flex;gap:28px;overflow-x:auto;white-space:nowrap;font-family:var(--mono);font-size:13px;letter-spacing:.08em;text-transform:uppercase}
  .sections a{padding:12px 0;text-decoration:none;color:var(--muted)}
  .sections a:hover{color:var(--ink)}
  header{border-bottom:1px solid var(--line)}

  /* Hero */
  .hero{gap:clamp(40px,6vw,88px);align-items:flex-start}
  .hero-main{flex:999 1 520px;min-width:0}
  h1{font-size:clamp(44px,6.4vw,88px);line-height:1.02;letter-spacing:-.02em}
  .lede{margin:28px 0 0;max-width:600px;font-size:clamp(18px,1.6vw,21px);color:var(--muted)}
  form.sub{margin:36px 0 0;max-width:560px}
  form.sub label{display:block;font-size:14px;font-weight:500;margin-bottom:8px}
  .field{display:flex;flex-wrap:wrap;gap:10px}
  .field input{flex:1 1 240px;min-width:0;min-height:52px;padding:0 18px;border-radius:10px;border:1px solid var(--line-strong);background:var(--surface);color:var(--ink);font:400 16px var(--sans)}
  .field button{min-height:52px;padding:0 26px;border-radius:10px;font-size:16px}
  .fine{margin:12px 0 0;font-size:14px;color:var(--muted)}
  .fine a{color:var(--accent-ink);font-weight:500}
  .issue{flex:1 1 340px;min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:28px 28px 12px}
  .issue-label{margin:0 0 4px;font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
  .issue ol{list-style:none;margin:0;padding:0}
  .issue li{display:flex;gap:16px;padding:18px 0;border-bottom:1px solid var(--line)}
  .issue li:last-child{border-bottom:0}
  .num{font-family:var(--mono);font-size:13px;color:var(--accent-ink);padding-top:3px}
  .issue strong{display:block;font-family:var(--serif);font-size:21px;font-weight:500;line-height:1.3}
  .issue span.d{font-size:15px;color:var(--muted)}

  /* Cards */
  .cols{margin-top:56px;gap:40px}
  .col{flex:1 1 300px;min-width:0;border-top:2px solid var(--ink);padding-top:24px}
  .col h3{font-size:28px;line-height:1.2;margin-bottom:12px}
  .col p{margin:0;color:var(--muted)}

  .band{background:var(--band);color:#F3F2FF}
  .band .eyebrow{color:#2EF2A0}
  .steps{margin-top:56px;gap:24px}
  .step{flex:1 1 300px;min-width:0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:32px}
  .step .n{font-family:var(--serif);font-size:64px;line-height:1;color:#2EF2A0}
  .step h3{margin:20px 0 10px;font-size:28px}
  .step p{margin:0;color:#C9C7EC}

  .blog-head{align-items:flex-end;justify-content:space-between;gap:20px}
  .link-arrow{min-height:44px;display:inline-flex;align-items:center;font-weight:600;color:var(--accent-ink);text-decoration:none}
  .link-arrow:hover{text-decoration:underline}
  .posts{margin-top:48px;gap:24px}
  .post{flex:1 1 300px;min-width:0;display:block;text-decoration:none;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:28px;transition:border-color .15s}
  .post:hover{border-color:var(--line-strong)}
  .post .meta{margin:0 0 16px;font-family:var(--mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .post h3{font-size:26px;line-height:1.25;margin-bottom:12px}
  .post p{margin:0;font-size:15px;color:var(--muted)}

  .nl{background:var(--surface);border:1px solid var(--line);border-radius:24px;padding:clamp(32px,5vw,64px);gap:32px;align-items:center;justify-content:space-between}
  .nl > div{flex:1 1 420px;min-width:0}
  .nl h2{font-size:clamp(30px,3.4vw,44px);margin-bottom:12px}
  .nl form{flex:1 1 380px;min-width:0;margin:0}
  .nl .field input{background:var(--bg)}

  .about{gap:clamp(40px,6vw,88px)}
  .about > div{flex:1 1 420px;min-width:0}
  .founder{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:32px}
  .who{display:flex;align-items:center;gap:18px}
  .avatar{width:64px;height:64px;border-radius:999px;background:#2F2A93;color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:26px;font-weight:500;flex:0 0 auto}
  .who .name{font-family:var(--serif);font-size:26px;font-weight:500;line-height:1.2}
  .creds{margin:24px 0 0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px}
  .creds li{display:flex;gap:12px}
  .creds li::before{content:"";flex:0 0 8px;height:8px;margin-top:10px;border-radius:999px;background:var(--green)}

  .contact{text-align:center}
  .contact h2{margin:0 auto 20px;max-width:760px}
  .contact p{margin:0 auto 32px;max-width:560px}
  .btn-ink{background:var(--ink);color:var(--bg);min-height:56px;padding:0 32px;font-size:17px}

  footer .wrap{display:flex;flex-wrap:wrap;gap:16px 32px;align-items:center;justify-content:space-between;font-size:14px;color:var(--muted);padding-top:32px;padding-bottom:32px}
  footer .links{display:flex;flex-wrap:wrap;gap:8px 24px}
  footer a{color:var(--muted)}
  footer a:hover{color:var(--ink)}
  @media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}}
</style>
</head>
